# Tool versions the workflows install and the local runners verify.
#
# One place. The workflows source this file before installing a tool, and
# scripts/toolchain/toolchain.sh (gates.py, the gate checks, the eval runner and
# ephemeral.sh) refuses to run when the local binary is another version: the same
# yq expression evaluates differently across 4.x releases, and a check that
# passed on a laptop failed in the nightly because of it (#21, #39).
#
# Bump a version here, run scripts/toolchain/install.sh, and re-run the gate tests.
YQ_VERSION=4.44.3

# Render tools of validate-zitadel.yml (kustomize build --enable-helm of the zitadel stack).
# The rendered output, and so the Argo hook/wave and namespace assertions, depends on both.
KUSTOMIZE_VERSION=5.8.3
HELM_VERSION=4.3.0

# k3d of the nightly use-case E2E (usecase-e2e-nightly.yml). Downloaded by direct URL, not install.sh (which asks the
# GitHub API for a release and fails when the runner is rate-limited), and checked against the release's sha256
# (checksums.txt of the release: kustomize_v${KUSTOMIZE_VERSION}_linux_amd64.tar.gz and k3d-linux-amd64).
K3D_VERSION=5.9.0
K3D_LINUX_AMD64_SHA256=06d8f25bc3a971c4eb29e0ff08429b180402db0f4dec838c9eac427e296800a0
KUSTOMIZE_LINUX_AMD64_SHA256=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61
