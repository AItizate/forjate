# Tool versions the workflows install and the local runners verify.
#
# One place. The workflows source this file before installing a tool, and
# scripts/toolchain/toolchain.sh (gates.py, the gate checks, the eval runner and
# ephemeral.sh) refuses to run when the local binary is another version: the same
# yq expression evaluates differently across 4.x releases, and a check that
# passed on a laptop failed in the nightly because of it (#21, #39).
#
# Bump a version here, run scripts/toolchain/install.sh, and re-run the gate tests.
YQ_VERSION=4.44.3
