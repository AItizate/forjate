# Becomes the key config-yaml of the Secret zitadel-db-config. Zitadel MERGES it over
# the chart's ConfigMap, so only what differs from the component defaults goes here.
ExternalDomain: zitadel.acme.dev            # HOSTNAME 3/3 (same as the Ingress host)
FirstInstance:
  Org:
    Human:
      Email:
        # The first admin's email. It must NOT be the email of any user in bootstrap.yaml (nor of
        # any other human user): with `auto_linking: email` two users with one email cannot be told
        # apart and the IdP login ends in "account not found". A plus-address of your own works.
        Address: zitadel-admin@acme.dev
Database:
  postgres:
    User:
      Username: zitadel
      Password: REPLACE_SAME_AS_POSTGRES_PASSWORD
    Admin:
      Username: zitadel
      Password: REPLACE_SAME_AS_POSTGRES_PASSWORD
