# Becomes the key config-yaml of the Secret zitadel-db-config. Zitadel MERGES it over
# the chart's ConfigMap, so only what differs from the component defaults goes here.
ExternalDomain: zitadel.acme.dev            # HOSTNAME 3/3 (same as the Ingress host)
FirstInstance:
  Org:
    Human:
      Email:
        Address: ana@acme.dev               # the first admin's email
Database:
  postgres:
    User:
      Username: zitadel
      Password: REPLACE_SAME_AS_POSTGRES_PASSWORD
    Admin:
      Username: zitadel
      Password: REPLACE_SAME_AS_POSTGRES_PASSWORD
