# Keypair of the Login V2 service (Secret zitadel-login-service-key, type tls).
# Self-signed is fine: Zitadel only checks the JWT signature against tls.crt.
# Generate it ONCE and seal/store it; a new key on every build rolls both Deployments.
openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=login-service" \
  -keyout tls.key -out tls.crt
kubectl create secret tls zitadel-login-service-key -n zitadel \
  --cert=tls.crt --key=tls.key --dry-run=client -o yaml \
  | kubeseal --format yaml > ../zitadel-login-service-key-sealed.yaml
rm tls.key tls.crt
# With cert-manager instead: a Certificate with secretName zitadel-login-service-key,
# privateKey {algorithm: RSA, rotationPolicy: Never} and a self-signed Issuer.
