# Demo-only credentials for the quickstart overlay. Safe to commit because:
# - the cluster is local (k3d) with no external ingress
# - LiteLLM listens only on ClusterIP, no Service exposed outside the cluster
# - the master key only authenticates the in-cluster validation Job
# Real environments use SealedSecrets / Vault / an external secret store instead.
LITELLM_MASTER_KEY=sk-quickstart-localdev-only
LITELLM_SALT_KEY=quickstart-localdev-salt-only
