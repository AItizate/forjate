# The owner account the seed Job creates during Home Assistant onboarding, and
# that every lifecycle Job logs in with afterwards.
#
# Dev-only values for a throwaway local environment on a ClusterIP-only k3d
# cluster with no route in from outside. The real .env is gitignored and seeded
# from this file by the runner and by CI.
HA_USERNAME=forjate
HA_PASSWORD=forjate-local-dev-only
