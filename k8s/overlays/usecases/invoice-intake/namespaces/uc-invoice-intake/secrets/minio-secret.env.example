# minio-secret -- replace values before sealing (apps/minio/dev)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     not sealed at Crawl (secretGenerator from this file's gitignored copy); from Walk: ./scripts/convert-to-sealed-secret.sh
# Secret name: minio-secret   namespace: uc-invoice-intake   keys: MINIO_ROOT_USER, MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=app
MINIO_ROOT_PASSWORD=ephemeral-local-only
