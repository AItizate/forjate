# argocd-repo-creds -- replace values before sealing (ArgoCD repo-server SSH wiring (namespace argocd))
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-argocd-repo-creds.yaml)
# Secret name: argocd-repo-creds   namespace: argocd   keys: type, url, sshPrivateKey
type=CHANGE_ME
url=CHANGE_ME
sshPrivateKey=CHANGE_ME
