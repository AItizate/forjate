# argocd-ssh-keys -- replace values before sealing (ArgoCD repo-server SSH wiring (namespace argocd))
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-argocd-ssh-keys.yaml)
# Secret name: argocd-ssh-keys   namespace: argocd   keys: ssh_config, id_ed25519
ssh_config=CHANGE_ME
id_ed25519=CHANGE_ME
