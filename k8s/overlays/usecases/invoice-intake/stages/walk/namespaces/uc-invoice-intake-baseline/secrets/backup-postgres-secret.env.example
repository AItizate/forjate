# backup-postgres-secret -- replace values before sealing (backup_reader, read-only on all six databases; mounted by the backup job only, as sensitive as the data per data-store R15)
# To generate: openssl rand -hex 32   (PGPASSWORD equals BACKUP_READER_PASSWORD in postgres-init-secret)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-backup-postgres-secret.yaml)
# Secret name: backup-postgres-secret   namespace: uc-invoice-intake-baseline   keys: PGUSER, PGPASSWORD
PGUSER=backup_reader
PGPASSWORD=CHANGE_ME
