# gotrue-secret -- replace values before sealing (apps/auth/gotrue-auth, which runs in uc-invoice-intake-baseline; sealed once per namespace)
# To generate: openssl rand -hex 32   (one value per key; the DATABASE_URL password equals GOTRUE_PASSWORD in postgres-init-secret, role gotrue, database gotrue_auth per data-store)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-gotrue-secret.yaml)
# Secret name: gotrue-secret   namespace: uc-invoice-intake-baseline   keys: GOTRUE_JWT_SECRET, DATABASE_URL, GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID, GOTRUE_EXTERNAL_GOOGLE_SECRET
GOTRUE_JWT_SECRET=CHANGE_ME
DATABASE_URL=postgres://gotrue:CHANGE_ME@postgres:5432/gotrue_auth?search_path=auth
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=CHANGE_ME
GOTRUE_EXTERNAL_GOOGLE_SECRET=CHANGE_ME
