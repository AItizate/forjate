# litellm-postgres-secret -- replace values before sealing (the gateway's own role and database on the one server; the litellm Deployment requires this Secret)
# To generate: openssl rand -hex 32   (the DATABASE_URL password equals LITELLM_PASSWORD in postgres-init-secret)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-litellm-postgres-secret.yaml)
# Secret name: litellm-postgres-secret   namespace: uc-invoice-intake-baseline   keys: DATABASE_URL
DATABASE_URL=postgresql://litellm:CHANGE_ME@postgres:5432/litellm
