# postgres-init-secret -- replace values before sealing (every role's password, read by the postgres-init Job only)
# To generate: openssl rand -hex 32   (one value per key; each must equal the password in that role's own Secret: temporal-, litellm-, backup-, working-, episodic-postgres-secret, gotrue-secret)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-postgres-init-secret.yaml)
# Secret name: postgres-init-secret   namespace: uc-invoice-intake-baseline   keys: INVOICE_WORKING_PASSWORD, INVOICE_EPISODIC_PASSWORD, TEMPORAL_PASSWORD, GOTRUE_PASSWORD, LITELLM_PASSWORD, BACKUP_READER_PASSWORD, TENANT_PROBE_PASSWORD
INVOICE_WORKING_PASSWORD=CHANGE_ME
INVOICE_EPISODIC_PASSWORD=CHANGE_ME
TEMPORAL_PASSWORD=CHANGE_ME
GOTRUE_PASSWORD=CHANGE_ME
LITELLM_PASSWORD=CHANGE_ME
BACKUP_READER_PASSWORD=CHANGE_ME
TENANT_PROBE_PASSWORD=CHANGE_ME
