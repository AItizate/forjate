# postgres-secret -- replace values before sealing (the admin login of the one server, in uc-invoice-intake-baseline; mounted by the StatefulSet and postgres-init only, data-store)
# To generate: openssl rand -hex 32   (POSTGRES_PASSWORD only; the bootstrap superuser is named postgres and its database is the maintenance database)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-postgres-secret.yaml)
# Secret name: postgres-secret   namespace: uc-invoice-intake-baseline   keys: POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
