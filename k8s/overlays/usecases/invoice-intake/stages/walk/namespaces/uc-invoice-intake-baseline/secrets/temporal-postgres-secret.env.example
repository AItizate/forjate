# temporal-postgres-secret -- replace values before sealing (the engine's own role on the one server; temporal-server reads it, never the admin login)
# To generate: openssl rand -hex 32   (POSTGRES_PASSWORD equals TEMPORAL_PASSWORD in postgres-init-secret)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-temporal-postgres-secret.yaml)
# Secret name: temporal-postgres-secret   namespace: uc-invoice-intake-baseline   keys: POSTGRES_USER, POSTGRES_PASSWORD
POSTGRES_USER=temporal
POSTGRES_PASSWORD=CHANGE_ME
