# bank-hash-salt -- replace values before sealing (scaffold:invoice-intake-seed)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-bank-hash-salt.yaml)
# Secret name: bank-hash-salt   namespace: uc-invoice-intake   keys: BANK_HASH_SALT
BANK_HASH_SALT=CHANGE_ME
