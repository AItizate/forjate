# double-admin-token -- replace values before sealing (scaffold:invoice-intake-seed)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-double-admin-token.yaml)
# Secret name: double-admin-token   namespace: uc-invoice-intake   keys: DOUBLE_ADMIN_TOKEN
DOUBLE_ADMIN_TOKEN=CHANGE_ME
