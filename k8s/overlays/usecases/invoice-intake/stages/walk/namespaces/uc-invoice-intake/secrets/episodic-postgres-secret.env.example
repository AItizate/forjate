# episodic-postgres-secret -- replace values before sealing (role invoice_episodic on database invoice_episodic; postgres is the alias to the one server)
# To generate: openssl rand -hex 32   (the URL password equals INVOICE_EPISODIC_PASSWORD in postgres-init-secret)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-episodic-postgres-secret.yaml)
# Secret name: episodic-postgres-secret   namespace: uc-invoice-intake   keys: EPISODIC_DATABASE_URL
EPISODIC_DATABASE_URL=postgresql://invoice_episodic:CHANGE_ME@postgres:5432/invoice_episodic
