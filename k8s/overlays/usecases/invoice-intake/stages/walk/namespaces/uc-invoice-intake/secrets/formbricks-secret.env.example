# formbricks-secret -- replace values before sealing (apps/surveys/formbricks)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-formbricks-secret.yaml)
# Secret name: formbricks-secret   namespace: uc-invoice-intake   keys: NEXTAUTH_SECRET, ENCRYPTION_KEY, CRON_SECRET, DATABASE_URL
NEXTAUTH_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
CRON_SECRET=CHANGE_ME
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/formbricks
