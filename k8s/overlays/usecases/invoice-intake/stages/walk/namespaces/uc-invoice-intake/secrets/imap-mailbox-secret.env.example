# imap-mailbox-secret -- replace values before sealing (integration: IMAP mailbox: poll)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-imap-mailbox-secret.yaml)
# Secret name: imap-mailbox-secret   namespace: uc-invoice-intake   keys: IMAP_MAILBOX_TOKEN
IMAP_MAILBOX_TOKEN=CHANGE_ME
