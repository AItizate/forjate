# mailbox-list-token -- replace values before sealing (scaffold:worker)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-mailbox-list-token.yaml)
# Secret name: mailbox-list-token   namespace: uc-invoice-intake   keys: MAILBOX_LIST_TOKEN
MAILBOX_LIST_TOKEN=CHANGE_ME
