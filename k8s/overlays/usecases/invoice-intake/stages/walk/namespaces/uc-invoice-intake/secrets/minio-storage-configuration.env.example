# minio-storage-configuration -- replace values before sealing (apps/minio/single-server)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-minio-storage-configuration.yaml)
# Secret name: minio-storage-configuration   namespace: uc-invoice-intake   keys: config.env
config.env="export MINIO_ROOT_USER=app\nexport MINIO_ROOT_PASSWORD=CHANGE_ME"
