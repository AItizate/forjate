# odoo-bank-ref-token -- replace values before sealing (scaffold:worker)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-odoo-bank-ref-token.yaml)
# Secret name: odoo-bank-ref-token   namespace: uc-invoice-intake   keys: ODOO_BANK_REF_TOKEN
ODOO_BANK_REF_TOKEN=CHANGE_ME
