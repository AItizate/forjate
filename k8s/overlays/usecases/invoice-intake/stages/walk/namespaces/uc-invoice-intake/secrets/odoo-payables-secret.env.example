# odoo-payables-secret -- replace values before sealing (integration: odoo-payables: rest-push)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-odoo-payables-secret.yaml)
# Secret name: odoo-payables-secret   namespace: uc-invoice-intake   keys: ODOO_PAYABLES_TOKEN
ODOO_PAYABLES_TOKEN=CHANGE_ME
