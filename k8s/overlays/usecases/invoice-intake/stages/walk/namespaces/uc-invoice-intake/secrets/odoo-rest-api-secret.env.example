# odoo-rest-api-secret -- replace values before sealing (integration: Odoo REST API: rest-push)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-odoo-rest-api-secret.yaml)
# Secret name: odoo-rest-api-secret   namespace: uc-invoice-intake   keys: ODOO_REST_API_TOKEN
ODOO_REST_API_TOKEN=CHANGE_ME
