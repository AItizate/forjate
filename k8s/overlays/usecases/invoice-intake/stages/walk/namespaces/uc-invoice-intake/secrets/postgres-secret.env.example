# postgres-secret -- replace values before sealing (apps/databases/postgres)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-postgres-secret.yaml)
# Secret name: postgres-secret   namespace: uc-invoice-intake   keys: POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
