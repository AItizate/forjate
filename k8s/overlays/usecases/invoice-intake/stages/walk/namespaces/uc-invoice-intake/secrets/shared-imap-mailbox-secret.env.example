# shared-imap-mailbox-secret -- replace values before sealing (integration: shared-imap-mailbox: poll)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-shared-imap-mailbox-secret.yaml)
# Secret name: shared-imap-mailbox-secret   namespace: uc-invoice-intake   keys: SHARED_IMAP_MAILBOX_TOKEN
SHARED_IMAP_MAILBOX_TOKEN=CHANGE_ME
