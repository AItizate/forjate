# working-postgres-secret -- replace values before sealing (role invoice_working on database invoice_working; postgres is the alias to the one server)
# To generate: openssl rand -hex 32   (the URL password equals INVOICE_WORKING_PASSWORD in postgres-init-secret)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-working-postgres-secret.yaml)
# Secret name: working-postgres-secret   namespace: uc-invoice-intake   keys: WORKING_DATABASE_URL
WORKING_DATABASE_URL=postgresql://invoice_working:CHANGE_ME@postgres:5432/invoice_working
