# cloudflare-tunnel-secret -- replace values before sealing (apps/cloudflare-tunnel)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-cloudflare-tunnel-secret.yaml)
# Secret name: cloudflare-tunnel-secret   namespace: uc-support-copilot   keys: TUNNEL_TOKEN
TUNNEL_TOKEN=CHANGE_ME
