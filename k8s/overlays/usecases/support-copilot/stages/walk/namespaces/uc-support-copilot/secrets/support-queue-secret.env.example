# support-queue-secret -- replace values before sealing (integration: support queue: rest-push)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-support-queue-secret.yaml)
# Secret name: support-queue-secret   namespace: uc-support-copilot   keys: SUPPORT_QUEUE_TOKEN
SUPPORT_QUEUE_TOKEN=CHANGE_ME
