# telegram-bot-api-secret -- replace values before sealing (integration: Telegram Bot API: webhook)
# To generate: openssl rand -hex 32   (one value per key; database credentials as the component documents)
# To seal:     ./scripts/convert-to-sealed-secret.sh   (select the overlay; writes secrets/sealed-telegram-bot-api-secret.yaml)
# Secret name: telegram-bot-api-secret   namespace: uc-support-copilot   keys: TELEGRAM_BOT_API_TOKEN
TELEGRAM_BOT_API_TOKEN=CHANGE_ME
